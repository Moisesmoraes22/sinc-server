<?xml version="1.0" encoding="utf-8"?>
<!--
  Fragmento de manifest mesclado apenas na build debug (Gradle faz o merge
  automaticamente com app/src/main/AndroidManifest.xml). Habilita o
  network_security_config que libera HTTP puro so para testes locais.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
