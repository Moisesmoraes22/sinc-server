# Fonte de dados
# real -> consulta a URL real de monitoramento
# mock -> usa dados simulados (uso em desenvolvimento/teste, sem dependência externa)
SOURCE_MODE=mock

SOURCE_URL=http://cli-1237.ddns.a7cloud.net.br:8080/online/monitorsincronizacao/
SOURCE_TIMEOUT_SECONDS=10

# Polling
POLL_INTERVAL_SECONDS=30
RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=2

# Regras de status (nao criar notificacao falsa por falha momentanea)
FAILURE_THRESHOLD_ATTENTION=1
FAILURE_THRESHOLD_OFFLINE=3

# Banco de dados
DATABASE_URL=sqlite:///./sinc.db

# Firebase Cloud Messaging
# Caminho para o service account JSON (NUNCA commitar este arquivo)
FIREBASE_CREDENTIALS_PATH=./firebase-adminsdk.json
FCM_TOPIC=sinc-alerts
# Se true, desativa envio real de FCM (usa apenas logs) - util sem credenciais Firebase
FCM_DRY_RUN=true

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
