# Fonte de dados
# real -> consulta a URL real de monitoramento
# mock -> usa dados simulados (uso em desenvolvimento/teste, sem dependencia externa)
SOURCE_MODE=mock

SOURCE_URL=http://cli-1237.ddns.a7cloud.net.br:8080/online/monitorsincronizacao/
SOURCE_TIMEOUT_SECONDS=10

# Polling (retry do ciclo de checagem - o INTERVALO entre ciclos vem de
# monitor_settings.check_interval_seconds, configurado no banco, nao aqui)
RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=2

# --- Banco de dados -----------------------------------------------------
# DB_BACKEND=supabase -> usa o PostgreSQL do Supabase (obrigatorio em producao)
# DB_BACKEND=sqlite   -> usa SQLite local (apenas dev sem Supabase configurado)
DB_BACKEND=supabase

# Supabase (ver docs/setup-supabase.md para como obter estes valores)
# SUPABASE_SERVICE_ROLE_KEY tem privilegios administrativos: NUNCA vai para
# o Android, NUNCA e commitada. Fica apenas neste .env, somente no backend.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SUBSTITUA_PELA_SUA_SERVICE_ROLE_KEY

# Usado apenas quando DB_BACKEND=sqlite
SQLITE_DATABASE_URL=sqlite:///./sinc.db

# Valores de fallback para monitor_settings, usados apenas se a tabela
# ainda nao tiver sido semeada (ver supabase/migrations/004_seed_settings.sql).
# A fonte da verdade em producao e sempre a tabela monitor_settings.
DEFAULT_WARNING_THRESHOLD_MINUTES=5
DEFAULT_CRITICAL_THRESHOLD_MINUTES=15
DEFAULT_CHECK_INTERVAL_SECONDS=60

# --- Firebase Cloud Messaging --------------------------------------------
# Caminho para o service account JSON (NUNCA commitar este arquivo)
FIREBASE_CREDENTIALS_PATH=./firebase-adminsdk.json
FCM_TOPIC=sinc-alerts
# Se true, desativa envio real de FCM (usa apenas logs) - util sem credenciais Firebase
FCM_DRY_RUN=true

# --- API ------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
